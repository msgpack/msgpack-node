#!/usr/bin/env node
// Read MessagePack data from stdin and write JSON data to stdout.

'use strict';

const msgpack = require('../lib/msgpack');

const chunks = [];

process.stdin.on('data', (d) => chunks.push(d));

process.stdin.on('end', () => {
    let buf = Buffer.concat(chunks);

    while (buf.length > 0) {
        let msg;
        try {
            msg = msgpack.unpack(buf);
        } catch (err) {
            console.error('msgpack2json: ' + err.message);
            process.exitCode = 1;
            return;
        }

        // null with nothing consumed means the message is incomplete.
        if (msg === null && msgpack.unpack.bytes_remaining === buf.length) {
            console.error('msgpack2json: incomplete MessagePack data on stdin');
            process.exitCode = 1;
            return;
        }

        console.log(JSON.stringify(msg));

        const remaining = msgpack.unpack.bytes_remaining;
        buf = remaining > 0 ? buf.subarray(buf.length - remaining) : buf.subarray(buf.length);
    }
});

// vim:ts=4 sw=4 et filetype=javascript
