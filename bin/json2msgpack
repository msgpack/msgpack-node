#!/usr/bin/env node
// Read JSON data from stdin and write MessagePack data to stdout.

'use strict';

const msgpack = require('../lib/msgpack');

const MAX_STDIN_BYTES = msgpack.MAX_STDIN_BYTES;
const chunks = [];
let n = 0;

process.stdin.on('data', (d) => {
    n += d.length;
    if (n > MAX_STDIN_BYTES) {
        console.error('json2msgpack: stdin exceeds MAX_STDIN_BYTES (' + MAX_STDIN_BYTES + ')');
        process.exit(1);
    }
    chunks.push(d);
});

process.stdin.on('end', () => {
    const text = Buffer.concat(chunks).toString('utf8');

    let value;
    try {
        value = JSON.parse(text);
    } catch (err) {
        console.error('json2msgpack: invalid JSON on stdin: ' + err.message);
        process.exitCode = 1;
        return;
    }

    let packed;
    try {
        packed = msgpack.pack(value);
    } catch (err) {
        console.error('json2msgpack: ' + err.message);
        process.exitCode = 1;
        return;
    }

    process.stdout.write(packed);
});

// vim:ts=4 sw=4 et filetype=javascript
